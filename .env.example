# =====================================================================
#  AOSCV — configuration (copier vers .env.local et compléter)
# =====================================================================

# --- Administration : /admin/paiements ---------------------------------
# Mot de passe de l'espace de validation des paiements (OBLIGATOIRE).
ADMIN_PASSWORD=abasse26

# Secret de signature des sessions (recommandé : 64 caractères hexadécimaux).
# À défaut, la session est signée avec ADMIN_PASSWORD.
ADMIN_SECRET=abasse26

# --- Notification Telegram à chaque paiement ---------------------------
# Créer un bot avec @BotFather, récupérer le token, puis envoyer un message
# au bot et relever le chat_id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paiement ----------------------------------------------------------
# Numéros qui reçoivent les 1 000 FCFA (libellés dans lib/payment.ts)
# PAYMENT_NUMBERS_ORANGE=+226 64 55 38 70
# PAYMENT_NUMBERS_MOOV=+226 62 13 49 70
